# Set local checkpoint paths and existing interpreters; no credentials needed.
MEETINGSCRIBE_REALTIME_URL=http://127.0.0.1:18499
REALTIME_PORT=18499
# CPU gateway remains available; GPU workers are loaded only on session start.
# Model port must be loopback-only, unused, and different from REALTIME_PORT.
REALTIME_MODEL_PORT=18500
REALTIME_IDLE_SECONDS=300
REALTIME_LOAD_SECONDS=480
REALTIME_QWEN_MODEL=/models/Qwen3-ASR-1.7B
REALTIME_ALIGNER_MODEL=/models/Qwen3-ForcedAligner-0.6B
REALTIME_NEMOTRON_MODEL=/models/Nemotron-3-Diarization.nemo
REALTIME_ASSISTANT_PYTHON=/runtimes/nemotron3/.venv/bin/python
REALTIME_ALIGNER_PYTHON=/runtimes/qwen3-asr-env/bin/python
# Existing helper folder; resolves the existing local FSMN VAD checkpoint.
REALTIME_SHARED_FUNASR=/runtimes/funasr-runtime
HF_HUB_OFFLINE=1
HF_DATASETS_OFFLINE=1
TOKENIZERS_PARALLELISM=false
VLLM_WORKER_MULTIPROC_METHOD=spawn
