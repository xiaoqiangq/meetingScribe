[Unit]
Description=Huiji P transcription service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/huiji-p
EnvironmentFile=-%h/huiji-p/.env
ExecStart=%h/huiji-p/huiji-p
Restart=always
RestartSec=10
TimeoutStopSec=45
KillMode=control-group
UMask=0077
LimitNOFILE=4096

[Install]
WantedBy=default.target
