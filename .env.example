HOST=127.0.0.1
PORT=8080
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
SECURE_COOKIES=false
DATABASE_PATH=data/scriberr.db
UPLOAD_DIR=data/uploads
TRANSCRIPTS_DIR=data/transcripts
WHISPERX_ENV=data/whisperx-env
JWT_SECRET_FILE=data/jwt_secret
TOPIC_NATIVE_REFERENCE_ROOT=data/nemotron-voiceprints
# OPENAI_API_KEY is optional; set real credentials only in local configuration.

# Resource limits (per owner unless noted)
MODEL_AUTO_PROVISION=false
QUEUE_WORKERS=1
USER_ACTIVE_JOB_LIMIT=3
MAX_UPLOAD_BYTES=1073741824
USER_STORAGE_QUOTA_BYTES=21474836480
LOGIN_REQUESTS_PER_MINUTE=10
# Optional systemd helper paths use absolute host paths, not container paths.
# HUIJI_HOME=/home/your-user/huiji-p
# HUIJI_DATA_DIR=/home/your-user/huiji-p/data
# HUIJI_BACKUP_DIR=/home/your-user/huiji-p/backups
HUIJI_HEALTH_URL=http://127.0.0.1:8080/health
